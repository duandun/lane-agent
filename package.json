{
  "name": "lane-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build",
    "dev:web": "cd apps/web && bun run dev",
    "dev:mobile": "cd apps/mobile && bun run dev",
    "dev:server": "cd apps/server && bun run dev",
    "build:app": "cd apps/desktop && bun run build",
    "electron:dev": "cd apps/desktop && bun run dev",
    "electron:start": "cd apps/desktop && bun run start",
    "electron:package": "cd apps/desktop && bun run package",
    "electron:package:linux": "cd apps/desktop && bun run package:linux",
    "electron:package:win": "cd apps/desktop && bun run package:win",
    "bundle:cli": "cd apps/desktop && node scripts/bundle-opencode-cli.mjs",
    "bundle:runtime": "cd apps/desktop && node scripts/bundle-runtime.mjs",
    "upload:mobile": "cd apps/mobile && ./upload.sh",
    "upload:server": "cd apps/server && ./upload.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
