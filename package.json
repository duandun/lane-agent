{
  "name": "opencode-web-demo",
  "version": "0.1.0",
  "description": "OpenCode Web 的 Electron 桌面壳",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "electron:dev": "vite & VITE_PID=$!; trap 'kill $VITE_PID' EXIT; electron . --dev",
    "electron:start": "vite build && electron .",
    "electron:package": "vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder",
    "electron:package:win": "vite build && ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --x64"
  },
  "build": {
    "appId": "com.opencode.web",
    "productName": "OpenCode Web",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!node_modules/**/*"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.10.0",
    "@ant-design/x-markdown": "^2.10.0",
    "@opencode/client": "^2.3.0",
    "antd": "^6.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-syntax-highlighter": "^16.1.2"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.0",
    "vite": "^8.3.8"
  }
}
